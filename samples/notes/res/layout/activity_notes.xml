<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/surface">
    <include layout="@layout/header" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:padding="@dimen/gap" android:gravity="center_vertical">
        <EditText android:id="@+id/input" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:hint="@string/hint" android:textColor="@color/text" />
        <Button android:id="@+id/add" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginLeft="8dp" android:text="@string/add" android:textColor="@color/on_primary"
            android:background="@drawable/button_bg" android:paddingLeft="20dp" android:paddingRight="20dp"
            android:paddingTop="10dp" android:paddingBottom="10dp" android:onClick="onAdd" />
    </LinearLayout>
    <CheckBox android:id="@+id/important" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginLeft="4dp" android:text="@string/important" />
    <TextView android:id="@+id/count" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:paddingLeft="@dimen/gap" android:paddingTop="4dp" android:textColor="@color/muted" />
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <LinearLayout android:id="@+id/list" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="vertical" android:padding="@dimen/gap" />
    </ScrollView>
</LinearLayout>
